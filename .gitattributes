# Detección automática para archivos no listados
* text=auto

# Texto con finales de línea CRLF
*.py text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.json text eol=crlf
.env.example text eol=crlf
.gitignore text eol=crlf
.gitattributes text eol=crlf

# Binarios
*.pdf binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
