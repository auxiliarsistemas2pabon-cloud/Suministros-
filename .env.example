# Copie este archivo como .env (copy .env.example .env) y complete los valores.
# El archivo .env NUNCA se sube al repositorio.
# Un valor vacío equivale a no definir la variable (se usa el valor por defecto).

# --- Django --------------------------------------------------------------------

# Obligatoria, sin valor por defecto. Genere una clave nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# True solo en desarrollo. Por defecto: False.
DJANGO_DEBUG=

# Dominios o IP permitidos, separados por comas. Ejemplo: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=

# Registro público: intentos por IP (5) y ventana en segundos (900).
PORTAL_REGISTRO_INTENTOS=
PORTAL_REGISTRO_VENTANA=

# --- PostgreSQL (lo usan Django y docker-compose.yml) --------------------------

# sqlite para desarrollo local (predeterminado); postgresql para Docker.
# En producción el predeterminado es postgresql. No migra datos entre motores.
DJANGO_BASE_DATOS=

# Obligatorias: nombre de la base, usuario y contraseña.
# No use el carácter $ en la contraseña: Docker Compose y Django lo interpretan
# distinto. Puede generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Por defecto: 127.0.0.1. En Windows, "localhost" intenta primero IPv6 (::1),
# donde Docker no publica el puerto, y cada conexión tarda varios segundos.
POSTGRES_HOST=
# Puerto en el equipo. Por defecto: 5433
POSTGRES_PORT=

# --- Producción (opcional) -----------------------------------------------------

# True activa redirección a HTTPS, cookies seguras y HSTS. Por defecto: False.
# Exige DJANGO_DEBUG=False y DJANGO_ALLOWED_HOSTS definido.
DJANGO_PRODUCCION=

# Segundos de HSTS. Por defecto: 3600. Súbalo (p. ej. 31536000) cuando
# confirme que todo funciona por HTTPS.
DJANGO_HSTS_SEGUNDOS=
# Incluir subdominios en HSTS (True/False). Por defecto: False.
DJANGO_HSTS_SUBDOMINIOS=
# Solicitar precarga HSTS en navegadores (True/False). Por defecto: False.
DJANGO_HSTS_PRELOAD=

# True solo si UN proxy inverso de confianza termina HTTPS y envía los
# encabezados X-Forwarded-Proto y X-Forwarded-For. Por defecto: False.
DJANGO_DETRAS_DE_PROXY=

# Orígenes de confianza para CSRF, separados por comas, con https://.
# Ejemplo: https://suministros.ejemplo.test
DJANGO_CSRF_TRUSTED_ORIGINS=
